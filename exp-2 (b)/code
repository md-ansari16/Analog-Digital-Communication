
% Experiment 2(b): Calculation and Verification of
% Frequency Deviation and Modulation Index of FM Signal

clc;
clear;
close all;

%% Message Signal Parameters
Am = 2;             % Message amplitude (V)
fm = 500;            % Message frequency (Hz)

%% Carrier Signal Parameters
Ac = 1;              % Carrier amplitude (V)
fc = 10000;           % Carrier frequency (Hz)

%% FM Parameters
kf = 250;             % Frequency sensitivity (Hz/V)
fs = 100000;          % Sampling frequency (Hz)
T = 0.01;             % Simulation duration (s)

%% Time Vector
t = 0:1/fs:T;

%% Message Signal
m = Am*cos(2*pi*fm*t);

%% Carrier Signal
c = Ac*cos(2*pi*fc*t);

%% Frequency Deviation
delta_f = kf*Am;

%% Modulation Index
beta = delta_f/fm;

%% FM Signal Generation
fm_signal = Ac*cos(2*pi*fc*t + beta*sin(2*pi*fm*t));

%% Display Parameters
fprintf('\nFM SIGNAL PARAMETERS\n');
fprintf('------------------------------\n');
fprintf('Carrier Frequency (fc) = %.0f Hz\n',fc);
fprintf('Message Frequency (fm) = %.0f Hz\n',fm);
fprintf('Message Amplitude (Am) = %.2f V\n',Am);
fprintf('Carrier Amplitude (Ac) = %.2f V\n',Ac);
fprintf('Frequency Sensitivity (kf) = %.0f Hz/V\n',kf);

%% Display Calculated Values
fprintf('\nCALCULATED VALUES\n');
fprintf('------------------------------\n');
fprintf('Frequency Deviation (Delta f) = %.2f Hz\n',delta_f);
fprintf('Modulation Index (Beta) = %.2f\n',beta);

%% Verification
beta_verify = delta_f/fm;

fprintf('\nVERIFICATION\n');
fprintf('------------------------------\n');
fprintf('Verified Modulation Index = %.2f\n',beta_verify);

tolerance = 1e-6;

if abs(beta-beta_verify) < tolerance
    fprintf('Verification Successful\n');
else
    fprintf('Verification Failed\n');
end

%% Plotting
figure('Name','FM Modulation Analysis','NumberTitle','off');

subplot(3,1,1);
plot(t,m,'LineWidth',1.2);
grid on;
title('Message Signal');
xlabel('Time (s)');
ylabel('Amplitude (V)');

subplot(3,1,2);
plot(t,c,'LineWidth',1.0);
grid on;
title('Carrier Signal');
xlabel('Time (s)');
ylabel('Amplitude (V)');

subplot(3,1,3);
plot(t,fm_signal,'LineWidth',1.0);
grid on;
title('Frequency Modulated (FM) Signal');
xlabel('Time (s)');
ylabel('Amplitude (V)');

fprintf('\nFM signal generated and plotted successfully.\n');
