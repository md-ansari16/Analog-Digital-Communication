
clc;
clear;
close all;

%% Fixed Input Sequence
input_bits = [1 0 0 1 1];

%% Convolutional Encoder Without Toolbox
% Constraint length = 3
% Generator polynomials: 7 and 5 (octal)

register = [0 0];  % Initial memory bits
encoded_bits = [];

for i = 1:length(input_bits)

    % Shift input bit into the register
    current_bit = input_bits(i);
    shift_register = [current_bit register];

    % Generator polynomial 7 (octal) = binary 111
    output1 = mod(sum(shift_register .* [1 1 1]), 2);

    % Generator polynomial 5 (octal) = binary 101
    output2 = mod(sum(shift_register .* [1 0 1]), 2);

    % Store encoded output pair
    encoded_bits = [encoded_bits output1 output2];

    % Update memory
    register = shift_register(1:2);
end

%% Create Encoding Table
encoded_pairs = reshape(encoded_bits, 2, [])';

output_pair = cell(length(input_bits), 1);

for i = 1:length(input_bits)
    output_pair{i} = sprintf('%d%d', ...
        encoded_pairs(i,1), encoded_pairs(i,2));
end

Bit_Position = (1:length(input_bits))';
Input_Bit = input_bits';
Output_Encoded = output_pair;

T = table(Bit_Position, Input_Bit, Output_Encoded);

disp('Convolutional Encoding Table');
disp(T);

disp('Encoded Output Bit Sequence:');
disp(encoded_bits);

%% Plot Input and Encoded Sequences
figure('Name', 'Convolutional Encoding', ...
    'NumberTitle', 'off');

subplot(2,1,1);
stairs(1:length(input_bits), input_bits, 'LineWidth', 1.5);
ylim([-0.2 1.2]);
title('Input Bit Sequence');
xlabel('Bit Position');
ylabel('Bit Value');
grid on;

subplot(2,1,2);
stairs(1:length(encoded_bits), encoded_bits, 'LineWidth', 1.5);
ylim([-0.2 1.2]);
title('Encoded Output Bit Sequence');
xlabel('Encoded Bit Position');
ylabel('Bit Value');
grid on;

disp('Convolutional encoding completed successfully.');
