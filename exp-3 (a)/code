
clc;
clear;
close all;

% Experiment 3(a): Phase Modulation and Phase Deviation

%% Parameters
Am = 1;              % Message amplitude (V)
fm = 100;            % Message frequency (Hz)
Ac = 5;              % Carrier amplitude (V)
fc = 1000;           % Carrier frequency (Hz)
fs = 20*fc;          % Sampling frequency (Hz)
kp = pi/2;           % Phase sensitivity (rad/V)

%% Time Vector
t = 0:1/fs:4/fm;

%% Message Signal
m = Am*sin(2*pi*fm*t);

%% Carrier Signal
c = Ac*cos(2*pi*fc*t);

%% Phase Modulated Signal
pm = Ac*cos(2*pi*fc*t + kp*m);

%% Phase Deviation and Modulation Index
phase_dev = kp*Am;
mp = phase_dev;

%% Display Results
fprintf('\nPHASE MODULATION PARAMETERS\n');
fprintf('------------------------------\n');
fprintf('Message Amplitude = %.2f V\n',Am);
fprintf('Message Frequency = %.0f Hz\n',fm);
fprintf('Carrier Amplitude = %.2f V\n',Ac);
fprintf('Carrier Frequency = %.0f Hz\n',fc);
fprintf('Phase Sensitivity = %.4f rad/V\n',kp);

fprintf('\nCALCULATED RESULTS\n');
fprintf('------------------------------\n');
fprintf('Phase Deviation = %.4f radians\n',phase_dev);
fprintf('PM Modulation Index = %.4f\n',mp);

%% Plotting
figure('Name','Phase Modulation and Phase Deviation', ...
    'NumberTitle','off');

subplot(2,2,1);
plot(t,m,'LineWidth',1.5);
title('Message Signal');
xlabel('Time (s)');
ylabel('Amplitude (V)');
grid on;

subplot(2,2,2);
plot(t,c,'LineWidth',1.2);
title('Carrier Signal');
xlabel('Time (s)');
ylabel('Amplitude (V)');
grid on;

subplot(2,2,3);
plot(t,pm,'LineWidth',1.2);
title('Phase Modulated Signal');
xlabel('Time (s)');
ylabel('Amplitude (V)');
grid on;

subplot(2,2,4);
bar(phase_dev);
title('Phase Deviation');
ylabel('Radians');
set(gca,'XTickLabel',{'PM Signal'});
grid on;

fprintf('\nPhase modulation signal generated successfully.\n');
